# ---- n8n ----
N8N_HOST=localhost
N8N_PORT=5678
# Generate: openssl rand -hex 16
N8N_ENCRYPTION_KEY=replace_with_random_32_char_hex
GENERIC_TIMEZONE=Asia/Karachi
TZ=Asia/Karachi

# ---- Postgres ----
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=n8n

# ---- Adzuna (https://developer.adzuna.com) ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# ---- Anthropic (https://console.anthropic.com) ----
ANTHROPIC_API_KEY=

# ---- Job filters (placeholders, edit later) ----
# Comma-separated list of target roles. Query-based sources (Adzuna, Remotive,
# HN) fire one call per keyword; filter-based sources (RemoteOK, Arbeitnow)
# match any keyword. Keep the list to ~15 max to stay under Adzuna's free cap.
JOB_KEYWORDS=AI Product Engineer,AI Application Engineer,AI Engineer,Generative AI Engineer,LLM Engineer,Software Engineer,Frontend Engineer,Frontend Developer,Full Stack Engineer,Full Stack Developer,Product Engineer,Frontend Lead,Staff Engineer,Staff Software Engineer
JOB_LOCATION=remote
JOB_MIN_SCORE=70
JOB_MAX_AGE_DAYS=7

# ---- Email (Gmail app password recommended) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_TO=
